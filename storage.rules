rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public assets (images / videos) - anyone can read, only admin can upload
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'admin@aqevorin.ai';
    }
  }
}
